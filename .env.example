# TikTok Research API credentials
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Meta Ad Library API
# Vygeneruj na: https://developers.facebook.com/tools/explorer/
# Prodluž na 60 dní: klikni "i" u tokenu → "Extend Access Token"
META_ACCESS_TOKEN=your_meta_access_token_here
